          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "oauth_binding",
            "in": "cookie",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }

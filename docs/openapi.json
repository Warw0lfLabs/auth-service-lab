    "/api/v1/auth/oauth/github/start": {
      "get": {
        "summary": "Start GitHub OAuth",
        "description": "Redirects to GitHub with PKCE; sets browser-binding cookie. Requires configured credentials.",
        "operationId": "start_github_oauth",
        "security": [],
        "responses": {
          "302": {
            "description": "Success",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Sanitized error (400/401/403/404/409/413/415/422/429/502/503/504/500 as applicable)",
            "content": {

  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Register": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string"
          },
          "display_name": {
            "default": "",
            "maxLength": 100,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Register",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "EmailInput": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailInput",
        "type": "object"
      },
      "TokenInput": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "TokenInput",
        "type": "object"
      },
      "PasswordChange": {
        "additionalProperties": false,
        "properties": {
          "current_password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChange",
        "type": "object"
      },
      "Reset": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "Reset",
        "type": "object"
      },
      "UserPatch": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 100,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "UserPatch",
        "type": "object"
      },
      "AdminPatch": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "user",
                  "admin"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "disabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Disabled"
          }
        },
        "title": "AdminPatch",
        "type": "object"
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "verified",
          "disabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "verified": {

                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oauth/github/callback": {
      "get": {
        "summary": "Complete GitHub OAuth",
        "description": "Consumes state and browser-binding cookie. Returns JSON tokens, not a frontend redirect. Existing local-email conflicts return 409.",
        "operationId": "complete_github_oauth",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
